{
  "manifest_version": 3,
  "name": "Fripe Connect",
  "version": "1.0.0",
  "description": "Publie tes articles Fripe sur Vinted en un clic : l'annonce est pré-remplie, tu n'as plus qu'à vérifier et publier.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Fripe Connect",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://fripe-iota.vercel.app/*",
    "https://www.vinted.fr/*",
    "https://www.vinted.be/*",
    "https://www.vinted.lu/*",
    "https://www.vinted.es/*",
    "https://www.vinted.it/*",
    "https://www.vinted.de/*",
    "https://www.vinted.at/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.pl/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.cz/*",
    "https://www.vinted.sk/*",
    "https://www.vinted.lt/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.com/*",
    "https://www.vinted.se/*",
    "https://www.vinted.fi/*",
    "https://www.vinted.dk/*",
    "https://www.vinted.ro/*",
    "https://www.vinted.hu/*",
    "https://www.vinted.hr/*",
    "https://www.vinted.gr/*",
    "https://www.vinted.ie/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fripe-iota.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.be/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.es/*",
        "https://www.vinted.it/*",
        "https://www.vinted.de/*",
        "https://www.vinted.at/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*",
        "https://www.vinted.se/*",
        "https://www.vinted.fi/*",
        "https://www.vinted.dk/*",
        "https://www.vinted.ro/*",
        "https://www.vinted.hu/*",
        "https://www.vinted.hr/*",
        "https://www.vinted.gr/*",
        "https://www.vinted.ie/*"
      ],
      "js": [
        "vinted.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
